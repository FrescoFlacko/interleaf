{
  "name": "interleaf",
  "productName": "Interleaf",
  "desktopName": "Interleaf.desktop",
  "description": "Interleaf — Read. Think. Build. A local-first reader, annotation, AI research, and agent execution environment.",
  "version": "0.12.3",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Interleaf"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "electron-vite dev --noRenderer",
    "build": "electron-vite build",
    "lint": "eslint . --max-warnings 0 && knip --no-progress",
    "quality:baseline": "python3 scripts/quality/gate.py baseline",
    "quality:check": "python3 scripts/quality/gate.py check",
    "quality:test": "python3 -m unittest discover -s tests/quality -v",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.0.11",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "linkedom": "0.18.13",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "pdfjs-dist": "6.4.299",
    "pele": "1.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "unicode-case-folding": "1.1.2",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "global-agent": "4.1.3",
    "mermaid": {
      "katex": "$katex"
    }
  }
}
